# --- Backend Flask (/api) ---------------------------------------------------
# Proveedor de email para notificar cada lead del formulario de contacto.
RESEND_API_KEY=
# Direccion que recibe las notificaciones de leads.
CONTACT_TO_EMAIL=ventas@baboons.co
# Remitente verificado en el proveedor de email.
CONTACT_FROM_EMAIL=web@baboons.co
# Opcional: webhook de Slack para avisar al equipo comercial.
SLACK_WEBHOOK_URL=

# --- Frontend (Vite) --------------------------------------------------------
# Las variables expuestas al cliente deben empezar con VITE_.
# Base de la API. En Vercel se sirve desde el mismo dominio en /api.
VITE_API_BASE_URL=/api
